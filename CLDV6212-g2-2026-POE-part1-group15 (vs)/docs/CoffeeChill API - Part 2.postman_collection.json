  "item": [
    {
      "name": "1. Menu",
      "item": [
        {
          "name": "Create Menu Item",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A new Id every run, so Create never clashes with an item that already exists (409).",
                  "pm.collectionVariables.set(\"menuItemId\", \"COF-\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "let item = null;",
                  "try { item = pm.response.json(); } catch (e) { item = null; }",
                  "pm.test(\"Returned item has the new Id and category\", function () {",
                  "    pm.expect(item.Id).to.eql(pm.collectionVariables.get(\"menuItemId\"));",
                  "    pm.expect(item.Category).to.eql(pm.collectionVariables.get(\"menuCategory\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Category\": \"{{menuCategory}}\",\n  \"Id\": \"{{menuItemId}}\",\n  \"Name\": \"Cappuccino\",\n  \"Description\": \"Espresso with steamed milk\",\n  \"Price\": 35.0,\n  \"IsAvailable\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/menu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu"
              ]
            },
            "description": "Creates a menu item in the MenuItems table. PartitionKey = Category, RowKey = Id."
          },
          "response": []
        },
        {
          "name": "Get All Menu Items",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "let items = null;",
                  "try { items = pm.response.json(); } catch (e) { items = null; }",
                  "pm.test(\"Response is a list\", function () {",
                  "    pm.expect(items).to.be.an(\"array\");",
                  "});",
                  "pm.test(\"The new menu item is in the list\", function () {",
                  "    const id = pm.collectionVariables.get(\"menuItemId\");",
                  "    let found = false;",
                  "    for (let i = 0; i < items.length; i++) {",
                  "        if (items[i].Id === id) { found = true; }",
                  "    }",
                  "    pm.expect(found).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/menu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Menu Items By Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "let items = null;",
                  "try { items = pm.response.json(); } catch (e) { items = null; }",
                  "pm.test(\"Every item is in the requested category\", function () {",
                  "    const category = pm.collectionVariables.get(\"menuCategory\");",
                  "    pm.expect(items.length).to.be.above(0);",
                  "    for (let i = 0; i < items.length; i++) {",
                  "        pm.expect(items[i].Category).to.eql(category);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",

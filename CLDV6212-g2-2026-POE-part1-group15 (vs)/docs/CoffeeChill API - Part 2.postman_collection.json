    {
      "name": "3. Orders (Queue)",
      "item": [
        {
          "name": "Queue Order",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A new OrderId every run, in the same format as the brief (ORD-2026-8801).",
                  "const now = new Date();",
                  "pm.collectionVariables.set(\"orderId\", \"ORD-\" + now.getFullYear() + \"-\" + String(Date.now()).slice(-6));",
                  "pm.collectionVariables.set(\"orderTimestamp\", now.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 202 Accepted\", function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "let result = null;",
                  "try { result = pm.response.json(); } catch (e) { result = null; }",
                  "pm.test(\"Order was placed on order-processing-queue\", function () {",
                  "    pm.expect(result.OrderId).to.eql(pm.collectionVariables.get(\"orderId\"));",
                  "    pm.expect(result.QueueName).to.eql(\"order-processing-queue\");",
                  "    pm.expect(result.Status).to.eql(\"Queued\");",
                  "});",
                  "pm.test(\"Queue message is Base64 encoded JSON of the order\", function () {",
                  "    const decoded = JSON.parse(atob(result.Base64Message));",
                  "    pm.expect(decoded.OrderId).to.eql(result.OrderId);",
                  "    pm.expect(decoded.TotalPrice).to.eql(65);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"OrderId\": \"{{orderId}}\",\n  \"CustomerName\": \"Jane Smith\",\n  \"SelectedItemSKUs\": [\n    \"COF-001\",\n    \"PAS-104\"\n  ],\n  \"TotalPrice\": 65.0,\n  \"OrderTimestamp\": \"{{orderTimestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders/queue",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "queue"
              ]
            },
            "description": "Queue producer. Returns 202 straight away; ProcessOrderQueue handles the order in the background."
          },
          "response": []
        },
        {
          "name": "Get Order - processing has started",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Give the queue function time to work before this request runs.",
                  "setTimeout(function () {}, 5000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "let order = null;",
                  "try { order = pm.response.json(); } catch (e) { order = null; }",
                  "pm.test(\"Queue function saved the order to the Orders table\", function () {",
                  "    pm.expect(order.OrderId).to.eql(pm.collectionVariables.get(\"orderId\"));",
                  "    pm.expect([\"Received\", \"Preparing\", \"Ready\"]).to.include(order.Status);",
                  "});",
                  "pm.test(\"PartitionKey (OrderDate) is the order date\", function () {",
                  "    const expected = pm.collectionVariables.get(\"orderTimestamp\").substring(0, 10);",
                  "    pm.expect(order.OrderDate).to.eql(expected);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Collect Order - too early (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"Explains the order is not Ready yet\", function () {",
                  "    pm.expect(pm.response.json().Message).to.include(\"only be collected once it is Ready\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/collect",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "collect"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Order - wait until Ready",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Give the queue function time to work before this request runs.",
                  "setTimeout(function () {}, 25000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Status moved Received -> Preparing -> Ready\", function () {",
                  "    pm.expect(pm.response.json().Status).to.eql(\"Ready\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            },
            "description": "Waits 25 seconds first (the queue function takes about 10 seconds per step)."
          },
          "response": []
        },
        {
          "name": "Collect Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Status is now Collected\", function () {",
                  "    pm.expect(pm.response.json().Status).to.eql(\"Collected\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/collect",

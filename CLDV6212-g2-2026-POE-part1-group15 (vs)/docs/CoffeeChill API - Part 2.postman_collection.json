                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/collect",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "collect"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get All Orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "let orders = null;",
                  "try { orders = pm.response.json(); } catch (e) { orders = null; }",
                  "pm.test(\"Our order is in the list as Collected\", function () {",
                  "    const id = pm.collectionVariables.get(\"orderId\");",
                  "    let match = null;",
                  "    for (let i = 0; i < orders.length; i++) {",
                  "        if (orders[i].OrderId === id) { match = orders[i]; }",
                  "    }",
                  "    pm.expect(match).to.not.be.null;",
                  "    pm.expect(match.Status).to.eql(\"Collected\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Queue Order - duplicate OrderId (409)",
          "event": [
            {
              "listen": "test",
              "script": {
